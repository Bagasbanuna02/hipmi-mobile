{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "app/(application)/admin/app-information/business-field/[id]",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}